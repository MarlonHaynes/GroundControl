# Normalize line endings: LF in the repository, native in the working tree.
* text=auto eol=lf

# Shell scripts and Docker entrypoints must be LF even on Windows.
*.sh text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf

# PowerShell is happiest with CRLF locally.
*.ps1 text eol=crlf

# Binary
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
