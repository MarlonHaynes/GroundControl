# ---------------------------------------------------------------------------
# GroundControl — environment configuration
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# --- LLM -------------------------------------------------------------------
# Required for the agent pipeline, dataset generation, and eval runs.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Pipeline model. Swappable without code changes.
#   claude-opus-5     $5/$25 per MTok   (~$0.10/quote)
#   claude-sonnet-5   $2/$10 per MTok   (~$0.04/quote)  <- project default
#   claude-haiku-4-5  $1/$5  per MTok   (~$0.02/quote)
LLM_MODEL=claude-sonnet-5

# Effort level for the pipeline's LLM calls: low | medium | high | xhigh | max
LLM_EFFORT=medium

# Max output tokens per LLM call.
LLM_MAX_TOKENS=8000

# Cache LLM responses on disk, keyed by (model, prompt_hash).
# Keeps eval re-runs free while iterating. Set to 0 to always call the API.
LLM_CACHE_ENABLED=1
LLM_CACHE_DIR=.llm_cache

# --- Database --------------------------------------------------------------
POSTGRES_USER=groundcontrol
POSTGRES_PASSWORD=groundcontrol
POSTGRES_DB=groundcontrol
POSTGRES_PORT=5434

# Published on host port 5434 by default (5432/5433 are commonly taken).
# Used by the API service. Inside docker-compose the host is `db`;
# for local (non-Docker) runs override to `localhost`.
DATABASE_URL=postgresql+psycopg://groundcontrol:groundcontrol@db:5432/groundcontrol

# --- API -------------------------------------------------------------------
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Pricing guardrails ----------------------------------------------------
# compute_quote refuses any total at or above this ceiling (in cents).
QUOTE_SANITY_CEILING_CENTS=5000000

# --- Matching thresholds ---------------------------------------------------
# >= CONFIDENT  -> linked silently
# >= REVIEW     -> linked but flagged needs_review
# <  REVIEW     -> treated as a new customer
CUSTOMER_MATCH_CONFIDENT=0.88
CUSTOMER_MATCH_REVIEW=0.65

# Any parsed field below this confidence flags the request for human review.
FIELD_CONFIDENCE_THRESHOLD=0.70

# --- Web -------------------------------------------------------------------
WEB_PORT=3000
# Browser-side base URL for the API (used by the Next.js client).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
